<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Format.fs" />
    <Compile Include="src/Types.fs" />
    <Compile Include="src/Data.fs" />
    <Compile Include="src/Charts.fs" />
    <Compile Include="src/State.fs" />
    <Compile Include="src/Views/Shared.fs" />
    <Compile Include="src/Views/Dashboard.fs" />
    <Compile Include="src/Views/Accounts.fs" />
    <Compile Include="src/Views/Transactions.fs" />
    <Compile Include="src/Views/Budget.fs" />
    <Compile Include="src/Views/CashFlow.fs" />
    <Compile Include="src/Views/Investments.fs" />
    <Compile Include="src/Views/Recurring.fs" />
    <Compile Include="src/Views/Goals.fs" />
    <Compile Include="src/App.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.400" />
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Feliz" Version="2.9.0" />
    <PackageReference Include="Feliz.UseElmish" Version="2.5.0" />
    <PackageReference Include="Fable.Elmish" Version="4.2.0" />
  </ItemGroup>

</Project>
